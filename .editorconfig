root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# стиль как у форматтера IntelliJ, чтобы Reformat Code и ktlint не спорили
ktlint_code_style = intellij_idea
max_line_length = 120
# как принято в Models.kt: классы с 2+ параметрами — по параметру на строку
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2
# ktor и IntelliJ сами пишут импорты через *, правило бы с ними спорило
ktlint_standard_no-wildcard-imports = disabled

[*.{yml,yaml}]
indent_size = 2

[backend/src/test/resources/logs/**]
# фикстуры — настоящие логи, их переводы строк проверяются
end_of_line = unset
insert_final_newline = unset
